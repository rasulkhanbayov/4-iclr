# Shared settings for every v2 job. Sourced by the scripts in this folder.
# SBATCH account/partition lines cannot use variables, so they are written in
# each script: A100 = -p gpu-A100 -A a100_hbku -q a100_hbku_qos,
#              H200 = -p gpu-H200 -A h200_hbku -q h200_hbku_qos.
export ICLR="/export/home/rakh90100/Rasul_research_ideas (2)/4-ICLR"
export CODE="$ICLR/REVISION/code"
export BASE="/export/hbku-research/rakh90100/physweep_revision"   # weights, envs, outputs (home is 89% full)
export ENV_MAIN="$BASE/envs/physweep2"
export ENV_COSMOS="$BASE/envs/physweep2-cosmos"
export HF_HOME="$BASE/hf_home"
# HF token: read ONLY the HF_TOKEN line from 4-ICLR/.env. Never `source` that
# file: it also sets HF_HOME to the old v1 cache in the (89% full) home dir.
if [ -f "$ICLR/.env" ]; then
    HF_TOKEN="$(grep -E '^HF_TOKEN=' "$ICLR/.env" | head -1 | cut -d= -f2- | tr -d "\"' \r")"
    export HF_TOKEN
fi
export TORCH_HOME="$BASE/torch_home"                     # CoTracker3 weights (torch.hub)
export PHYSWEEP_OUT="$BASE/runs"
export DC_ROOT="$ICLR/external/DynamiCrafter"
export DC_PYTHON="$ICLR/external/dynamicrafter_venv/bin/python"
export PYTHONNOUSERSITE=1      # never load packages from ~/.local (v1 shadowing bug)
export HF_HUB_DISABLE_PROGRESS_BARS=1
export TOKENIZERS_PARALLELISM=false

# Which env each model uses
env_for_model() { if [ "$1" = "cosmos2_2b" ]; then echo "$ENV_COSMOS"; else echo "$ENV_MAIN"; fi; }
